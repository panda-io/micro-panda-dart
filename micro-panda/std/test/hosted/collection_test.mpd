#if HOSTED
import test::assert
import hosted.collection::HeapList
import hosted.collection::HeapMap
import hosted.memory::HeapAllocator

@test
fun heaplist_push_pop()
    var heap: HeapAllocator
    var list: HeapList<i32>
    list.init(&heap)
    assert(list.push(10))
    assert(list.push(20))
    assert(list.push(30))
    assert(list.size() == 3)
    assert(list.get(0) == 10)
    assert(list.get(1) == 20)
    assert(list.get(2) == 30)
    assert(list.top() == 30)
    assert(list.pop())
    assert(list.size() == 2)
    assert(list.top() == 20)

@test
fun heaplist_grow()
    var heap: HeapAllocator
    var list: HeapList<i32>
    list.init(&heap)
    val initial := list.capacity()
    var i: u32 = 0
    while i <= initial
        assert(list.push(i32(i)))
        i += 1
    assert(list.size() == initial + 1)
    assert(list.capacity() > initial)

@test
fun heaplist_set_clear()
    var heap: HeapAllocator
    var list: HeapList<i32>
    list.init(&heap)
    list.push(1)
    list.push(2)
    list.set(0, 99)
    assert(list.get(0) == 99)
    list.clear()
    assert(list.is_empty())
    assert(list.size() == 0)

@test
fun heaplist_insert()
    var heap: HeapAllocator
    var list: HeapList<i32>
    list.init(&heap)
    list.push(10)
    list.push(30)
    assert(list.insert(1, 20))
    assert(list.size() == 3)
    assert(list.get(0) == 10)
    assert(list.get(1) == 20)
    assert(list.get(2) == 30)

@test
fun heaplist_insert_front()
    var heap: HeapAllocator
    var list: HeapList<i32>
    list.init(&heap)
    list.push(20)
    list.push(30)
    assert(list.insert(0, 10))
    assert(list.get(0) == 10)
    assert(list.get(1) == 20)
    assert(list.get(2) == 30)

@test
fun heaplist_insert_end()
    var heap: HeapAllocator
    var list: HeapList<i32>
    list.init(&heap)
    list.push(10)
    list.push(20)
    assert(list.insert(2, 30))
    assert(list.get(2) == 30)
    assert(list.size() == 3)

@test
fun heaplist_insert_grow()
    var heap: HeapAllocator
    var list: HeapList<i32>
    list.init(&heap)
    list.push(1)
    list.push(2)
    assert(list.insert(0, 0))
    assert(list.size() == 3)
    assert(list.get(0) == 0)
    assert(list.get(1) == 1)
    assert(list.get(2) == 2)

@test
fun heaplist_free()
    var heap: HeapAllocator
    var list: HeapList<i32>
    list.init(&heap)
    list.push(1)
    list.push(2)
    list.free()
    assert(list.size() == 0)
    assert(list.capacity() == 0)

@test
fun heapmap_set_get()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val key1: u8[] = "hello"
    val key2: u8[] = "world"
    m.set(key1, 42)
    m.set(key2, 99)
    assert(m.contains(key1))
    assert(m.contains(key2))
    assert(m.get(key1) == 42)
    assert(m.get(key2) == 99)
    assert(m.size() == 2)

@test
fun heapmap_contains()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val key: u8[] = "foo"
    assert(m.contains(key) == false)
    m.set(key, 1)
    assert(m.contains(key))

@test
fun heapmap_missing_key()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val key: u8[] = "missing"
    assert(m.contains(key) == false)

@test
fun heapmap_overwrite()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val key: u8[] = "k"
    m.set(key, 10)
    m.set(key, 20)
    assert(m.size() == 1)
    assert(m.contains(key))
    assert(m.get(key) == 20)

@test
fun heapmap_remove()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val key: u8[] = "del"
    m.set(key, 5)
    assert(m.contains(key))
    assert(m.remove(key))
    assert(m.contains(key) == false)
    assert(m.size() == 0)

@test
fun heapmap_remove_missing()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val key: u8[] = "nope"
    assert(m.remove(key) == false)

@test
fun heapmap_probe_through_tombstone()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val a: u8[] = "a"
    val b: u8[] = "b"
    val c: u8[] = "c"
    m.set(a, 1)
    m.set(b, 2)
    m.set(c, 3)
    m.remove(b)
    // c should still be findable after b is tombstoned
    assert(m.contains(c))
    assert(m.get(c) == 3)

@test
fun heapmap_grow()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val k0: u8[] = "k0"
    val k1: u8[] = "k1"
    val k2: u8[] = "k2"
    val k3: u8[] = "k3"
    val k4: u8[] = "k4"
    m.set(k0, 0)
    m.set(k1, 1)
    m.set(k2, 2)
    m.set(k3, 3)
    m.set(k4, 4)
    assert(m.size() == 5)
    assert(m.get(k0) == 0)
    assert(m.get(k1) == 1)
    assert(m.get(k2) == 2)
    assert(m.get(k3) == 3)
    assert(m.get(k4) == 4)

@test
fun heapmap_free()
    var heap: HeapAllocator
    var m: HeapMap<i32>
    m.init(&heap)
    val key: u8[] = "x"
    m.set(key, 7)
    m.free()
    assert(m.size() == 0)

#end
