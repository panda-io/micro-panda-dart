import math::min
import math::max
import math::clamp
import math::abs
import math::floor_q16
import math::ceil_q16
import math::round_q16
#if HOSTED || MCU32
import math::sin
import math::cos
import math::sqrt
import math::floor
import math::ceil
import math::round
#end

@test
fun test_min()
    assert(min<int>(3, 5) == 3)
    assert(min<int>(-1, 0) == -1)
    assert(min<u32>(10, 7) == 7)
    assert(min<float>(1.5, 2.5) == 1.5)
    assert(min<q16>(2.5, 1.5) == 1.5)

@test
fun test_max()
    assert(max<int>(3, 5) == 5)
    assert(max<int>(-1, 0) == 0)
    assert(max<float>(1.5, 2.5) == 2.5)
    assert(max<q16>(2.5, 1.5) == 2.5)

@test
fun test_clamp()
    assert(clamp<int>(5, 0, 10) == 5)
    assert(clamp<int>(-1, 0, 10) == 0)
    assert(clamp<int>(15, 0, 10) == 10)
    assert(clamp<float>(1.5, 0.0, 2.0) == 1.5)
    assert(clamp<q16>(1.5, 0.0, 2.0) == 1.5)

@test
fun test_abs()
    assert(abs<int>(-5) == 5)
    assert(abs<int>(5) == 5)
    assert(abs<int>(0) == 0)
    assert(abs<float>(-1.5) == 1.5)
    assert(abs<q16>(-1.5) == 1.5)


@test
fun test_floor_q16()
    // 1.5 in q16 = 0x00018000
    val v: q16 = 1.5
    assert(floor_q16(v) == 1.0)

@test
fun test_ceil_q16()
    val v: q16 = 1.5
    assert(ceil_q16(v) == 2.0)
    val w: q16 = 2.0
    assert(ceil_q16(w) == 2.0)

@test
fun test_round_q16()
    val v: q16 = 1.5
    assert(round_q16(v) == 2.0)
    val w: q16 = 1.4
    assert(round_q16(w) == 1.0)
    
#if HOSTED || MCU32
@test
fun test_sqrt()
    val r := sqrt(4.0)
    assert(r == 2.0)

@test
fun test_sin_cos()
    val s := sin(0.0)
    assert(s == 0.0)
    val c := cos(0.0)
    assert(c == 1.0)

@test
fun test_floor_ceil_round()
    assert(floor(1.7) == 1.0)
    assert(ceil(1.2) == 2.0)
    assert(round(1.5) == 2.0)
    assert(round(1.4) == 1.0)

#end
