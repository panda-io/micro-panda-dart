#if HOSTED || MCU32
import test::assert
import mcu32.collection::ArrayList
import mcu32.collection::RingBuffer
import mcu32.memory::Allocator

// ── ArrayList ────────────────────────────────────────────────────────────────

@test
fun arraylist_init()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var list: ArrayList<i32>
    assert(list.init(&alloc, 4))
    assert(list.is_empty())
    assert(list.size() == 0)
    assert(list.capacity() == 4)

@test
fun arraylist_push_pop()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var list: ArrayList<i32>
    list.init(&alloc, 4)
    assert(list.push(10))
    assert(list.push(20))
    assert(list.push(30))
    assert(list.size() == 3)
    assert(list.get(0) == 10)
    assert(list.get(1) == 20)
    assert(list.get(2) == 30)
    assert(list.top() == 30)
    assert(list.pop())
    assert(list.size() == 2)
    assert(list.top() == 20)

@test
fun arraylist_full()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var list: ArrayList<i32>
    list.init(&alloc, 2)
    assert(list.push(1))
    assert(list.push(2))
    assert(list.is_full())
    assert(list.push(3) == false)

@test
fun arraylist_set_clear()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var list: ArrayList<i32>
    list.init(&alloc, 4)
    list.push(1)
    list.push(2)
    list.set(0, 99)
    assert(list.get(0) == 99)
    list.clear()
    assert(list.is_empty())
    assert(list.size() == 0)

@test
fun arraylist_insert()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var list: ArrayList<i32>
    list.init(&alloc, 4)
    list.push(10)
    list.push(30)
    assert(list.insert(1, 20))
    assert(list.size() == 3)
    assert(list.get(0) == 10)
    assert(list.get(1) == 20)
    assert(list.get(2) == 30)

@test
fun arraylist_insert_front()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var list: ArrayList<i32>
    list.init(&alloc, 4)
    list.push(20)
    list.push(30)
    assert(list.insert(0, 10))
    assert(list.get(0) == 10)
    assert(list.get(1) == 20)
    assert(list.get(2) == 30)

@test
fun arraylist_insert_end()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var list: ArrayList<i32>
    list.init(&alloc, 4)
    list.push(10)
    list.push(20)
    assert(list.insert(2, 30))
    assert(list.get(2) == 30)
    assert(list.size() == 3)

@test
fun arraylist_insert_full()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var list: ArrayList<i32>
    list.init(&alloc, 2)
    list.push(1)
    list.push(2)
    assert(list.insert(0, 0) == false)

// ── RingBuffer ───────────────────────────────────────────────────────────────

@test
fun ringbuffer_init()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var rb: RingBuffer<i32>
    assert(rb.init(&alloc, 4))
    assert(rb.is_empty())
    assert(rb.size() == 0)
    assert(rb.capacity() == 4)

@test
fun ringbuffer_push_pop()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var rb: RingBuffer<i32>
    rb.init(&alloc, 4)
    assert(rb.push(10))
    assert(rb.push(20))
    assert(rb.push(30))
    assert(rb.size() == 3)
    assert(rb.peek() == 10)
    assert(rb.pop())
    assert(rb.peek() == 20)
    assert(rb.size() == 2)

@test
fun ringbuffer_wrap_around()
    var _mem: u8[512]
    var alloc: Allocator
    alloc.init({&_mem[0], u32(512)})
    var rb: RingBuffer<i32>
    rb.init(&alloc, 3)
    rb.push(1)
    rb.push(2)
    rb.push(3)
    assert(rb.is_full())
    assert(rb.push(4) == false)
    rb.pop()
    assert(rb.push(4))
    assert(rb.peek() == 2)
    rb.pop()
    assert(rb.peek() == 3)
    rb.pop()
    assert(rb.peek() == 4)
    assert(rb.size() == 1)

#end
