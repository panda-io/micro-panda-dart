import console::*

class Inner
    var inner_value: int

    fun inner_method()
        print("Inner method called")

class Outer
    var outter_value: int
    var inner: Inner

    fun outer_method()
        print("Outer method called")

val inner: Inner
val outer: Outer

@test
fun test_class()
    inner.inner_value = 10
    outer.outter_value = 20
    outer.inner = inner

    assert(inner.inner_value == 10)
    assert(outer.outter_value == 20)
    assert(outer.inner.inner_value == 10)

    outer.outer_method()
    outer.inner.inner_method()
