import console::*

// ── global counters (test-level, not assert-level) ────────────────────────────

var _succeeded: u32 = 0
var _failed: u32 = 0

// ── per-test state ────────────────────────────────────────────────────────────

var _current_name: byte[] = ""
var _current_failed: u32 = 0

// failure buffer: up to 8 failures per test
var _buf_count: u32 = 0
var _buf_lines: u32[8]
var _buf_files: byte[][8]
var _buf_exprs: byte[][8]

// ── called by generated assert code ──────────────────────────────────────────

fun _test_pass()
    // counted at test level in _test_end, nothing to do per assert

fun _test_fail(file: byte[], line: u32, expr: byte[])
    if _buf_count < 8
        _buf_files[_buf_count] = file
        _buf_lines[_buf_count] = line
        _buf_exprs[_buf_count] = expr
        _buf_count += 1
    _current_failed += 1

// ── called by generated test main() ──────────────────────────────────────────

fun _test_begin(name: byte[])
    _current_name = name
    _current_failed = 0
    _buf_count = 0

fun _test_end()
    if _current_failed == 0
        write_string("\x1b[32mP:")
        write_string(_current_name)
        write_string("\x1b[0m")
        write_byte(10)
        _succeeded += 1
    else
        write_string("\x1b[31mF:")
        write_string(_current_name)
        write_string("\x1b[0m")
        write_byte(10)
        var i: u32 = 0
        while i < _buf_count
            write_string("  ")
            write_string(_buf_files[i])
            write_string(":")
            write_u32(_buf_lines[i])
            write_string(": ")
            write_string(_buf_exprs[i])
            write_byte(10)
            i += 1
        _failed += 1

fun _report() int
    write_string("DONE ")
    write_u32(_succeeded)
    write_string("/")
    write_u32(_succeeded + _failed)
    write_byte(10)
    if _failed > 0
        return 1
    return 0
