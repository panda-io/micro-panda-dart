#if HOSTED || MCU32
import mcu32.allocator::Allocator

// ── ArrayList ─────────────────────────────────────────────────────────────────
// Fixed-capacity list backed by an Allocator. Works on MCU and hosted.
// push/insert return false when full.

class ArrayList<T>()
    var _buffer: T[]
    var _size: int = 0

    fun init(alloc: &Allocator, capacity: int) bool
        _buffer = alloc.allocate_array<T>(capacity)
        if _buffer.size() == 0
            return false
        return true

    @inline
    fun push(value: T) bool
        if _size >= _buffer.size()
            return false
        _buffer[_size] = value
        _size += 1
        return true

    @inline
    fun pop() bool
        if _size == 0
            return false
        _size -= 1
        return true

    fun insert(i: int, value: T) bool
        if _size >= _buffer.size()
            return false
        if i > _size
            return false
        var j: int = _size
        while j > i
            _buffer[j] = _buffer[j - 1]
            j -= 1
        _buffer[i] = value
        _size += 1
        return true

    @inline
    fun get(i: int) T
        return _buffer[i]

    @inline
    fun set(i: int, value: T)
        _buffer[i] = value

    @inline
    fun top() T
        return _buffer[_size - 1]

    @inline
    fun size() int
        return _size

    @inline
    fun capacity() int
        return _buffer.size()

    @inline
    fun is_empty() bool
        return _size == 0

    @inline
    fun is_full() bool
        return _size >= _buffer.size()

    @inline
    fun clear()
        _size = 0

// ── RingBuffer ────────────────────────────────────────────────────────────────
// Fixed-capacity circular buffer backed by an Allocator.

class RingBuffer<T>()
    var _buffer: T[]
    var _head: int = 0
    var _tail: int = 0
    var _size: int = 0

    fun init(allocator: &Allocator, capacity: int) bool
        _buffer = allocator.allocate_array<T>(capacity)
        if _buffer.size() == 0
            return false
        return true

    @inline
    fun push(value: T) bool
        if _size >= _buffer.size()
            return false
        _buffer[_tail] = value
        _tail = (_tail + 1) % _buffer.size()
        _size += 1
        return true

    @inline
    fun pop() bool
        if _size == 0
            return false
        _head = (_head + 1) % _buffer.size()
        _size -= 1
        return true

    @inline
    fun peek() T
        return _buffer[_head]

    @inline
    fun size() int
        return _size

    @inline
    fun capacity() int
        return _buffer.size()

    @inline
    fun is_empty() bool
        return _size == 0

    @inline
    fun is_full() bool
        return _size >= _buffer.size()

#end
