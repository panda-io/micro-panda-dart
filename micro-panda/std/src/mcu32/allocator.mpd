#if HOSTED || MCU32

class Allocator()
    var _memory: u8[] = {null, 0}
    var _cursor: i32 = 0

    fun init(mem: u8[])
        _memory = mem
        _cursor = 0

    @inline
    fun allocate<T>(): &T
        val size := sizeof<T>()
        if _cursor + size > _memory.size()
            return null
        val ptr := &T(&_memory[_cursor])
        _cursor = (_cursor + size + 3) & ~i32(3)
        return ptr

    @inline
    fun allocate_array<T>(length: i32): T[]
        val size := sizeof<T>() * length
        if _cursor + size > _memory.size()
            return {null, 0}
        val ptr := &T(&_memory[_cursor])
        _cursor = (_cursor + size + 3) & ~i32(3)
        return {ptr, length}

    @inline
    fun reset()
        _cursor = 0

#end
