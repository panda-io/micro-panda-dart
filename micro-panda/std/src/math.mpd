#if HOSTED || MCU32
@raw("#include <math.h>")

// ── Constants ─────────────────────────────────────────────────────────────────

const PI  := 3.14159265358979323846
const TAU := 6.28318530717958647692
const E   := 2.71828182845904523536
#end

// ── Generic min / max / clamp / abs ──────────────────────────────────────────

@inline
fun min<T>(a: T, b: T): T
    if a < b
        return a
    return b

@inline
fun max<T>(a: T, b: T): T
    if a > b
        return a
    return b

@inline
fun clamp<T>(value: T, low: T, high: T): T
    if value < low
        return low
    if value > high
        return high
    return value

@inline
fun abs<T>(value: T): T
    if value < 0
        return -value
    return value

// ── Q16 (16.16 fixed-point) rounding ─────────────────────────────────────────

@inline
fun floor_q16(value: q16): q16
    return value & -1.0

@inline
fun ceil_q16(value: q16): q16
    val result := value & -1.0
    if value != result
        return result + 1.0
    return result

@inline
fun round_q16(value: q16): q16
    return (value + 0.5) & -1.0

#if HOSTED || MCU32
