// ── transport ────────────────────────────────────────────────────────────────
//
// write_byte dispatches through a function pointer.
// Default: HOSTED/MCU32 → putchar wrapper.  Other MCU → NULL (call console::init(fn) before use).
// Override at runtime: console::init(fn) for custom transports (UART, USB, mock tests).
import string::format

#if HOSTED || MCU32
@raw("#include <stdio.h>")

@extern("putchar({b})")
fun _putchar(b: byte)

fun _write_byte_default(b: byte)
    _putchar(b)

var _write_byte: fun(byte) = _write_byte_default
#else
var _write_byte: fun(byte)
#end

fun init(write_byte: fun(byte))
    _write_byte = write_byte

@inline
fun write_byte(b: byte)
    _write_byte(b)

// ── primitives ───────────────────────────────────────────────────────────────

fun print(string: byte[])
    write_string(string)
    write_byte(10)

fun print_args(string: byte[], args: int[])
    var buf: byte[128]
    print(format(string, buf, args))

fun write_string(string: byte[])
    for i in 0..string.size()
        write_byte(string[i])

fun write_bool(value: bool)
    if value
        write_byte('t')
        write_byte('r')
        write_byte('u')
        write_byte('e')
    else
        write_byte('f')
        write_byte('a')
        write_byte('l')
        write_byte('s')
        write_byte('e')

// ── unsigned integers ─────────────────────────────────────────────────────────

fun write_u64(value: u64)
    var buf: byte[20]
    var i: int = 19
    if value == 0
        write_byte('0')
        return
    while value > 0
        buf[i] = byte(value % 10 + 48)
        value = value / 10
        i -= 1
    for  j in (i + 1)..20
        write_byte(buf[j])

fun write_u32(value: u32)
    write_u64(u64(value))

fun write_u16(value: u16)
    write_u64(u64(value))

fun write_u8(value: byte)
    write_u64(u64(value))

// ── signed integers ───────────────────────────────────────────────────────────

fun write_i64(value: i64)
    if value < 0
        write_byte('-')
        write_u64(u64(i64(0) - value))
    else
        write_u64(u64(value))

fun write_int(value: int)
    write_i64(i64(value))

fun write_i16(value: i16)
    write_i64(i64(value))

fun write_i8(value: i8)
    write_i64(i64(value))

// ── float ─────────────────────────────────────────────────────────────────────
//
// Naive float write: separates integer and fractional parts, extracts decimal
// digits by successive * 10. Accurate to ~6 significant digits (float precision).
// Does not handle NaN or Inf.

fun write_float(value: float)
    var abs: float = value
    if value < 0.0
        write_byte('-')
        abs = 0.0 - value
    val int_part := int(abs)
    write_int(int_part)
    write_byte('.')
    var frac: float = abs - float(int_part)
    for i in 0..4
        frac = frac * 10.0
        val digit := int(frac)
        write_byte(byte(digit + 48))
        frac = frac - float(digit)

// ── Q16 (16.16 fixed-point) ───────────────────────────────────────────────────
//
// 16.16 fixed-point: high 16 bits = integer part, low 16 bits = fractional part.
// e.g. write_q16(0x00018000) → "1.5000"   (1 + 32768/65536)
//      write_q16(0xFFFE8000) → "-1.5000"

fun write_q16(value: q16)
    var abs: u32 = 0
    if value < 0
        write_byte('-')
        abs = u32(0 - value)
    else
        abs = u32(value)

    // integer part: high 16 bits
    write_u32(abs >> 16)

    write_byte('.')
    // fractional part: low 16 bits
    // extract each decimal digit: multiply frac by 10, digit = high 16 bits
    var frac: u32 = abs & 0xFFFF
    for i in 0..4
        frac *= 10
        write_byte(byte((frac >> 16) + 48))
        frac = frac & 0xFFFF
