#if HOSTED

@include("unistd.h")
@include("time.h")

// Sleep for N microseconds.
@extern("usleep({us})")
fun sleep_us(us: u32)

// Monotonic microseconds — suitable for deadline-based loops.
@extern("({ struct timespec __ts; clock_gettime(CLOCK_MONOTONIC, &__ts); (int64_t)__ts.tv_sec * 1000000LL + __ts.tv_nsec / 1000LL; })")
fun time_us(): i64

#end
